# Скопируйте этот файл в caddy/Caddyfile и замените значения:
#   1) sellanalyzer.example.com  -> ваш домен (A-запись домена должна указывать на IP сервера)
#   2) analyst                   -> логин
#   3) ХЭШ_ПАРОЛЯ                -> результат команды:  docker run --rm -it caddy:2 caddy hash-password
# Сертификат HTTPS Caddy получает и продлевает сам.

sellanalyzer.example.com {
	encode gzip

	basic_auth {
		analyst ХЭШ_ПАРОЛЯ
	}

	reverse_proxy app:8501
}

# --- Вариант без домена, в локальной сети (самоподписанный сертификат, браузер покажет предупреждение) ---
# https://192.168.1.50 {
# 	tls internal
# 	basic_auth {
# 		analyst ХЭШ_ПАРОЛЯ
# 	}
# 	reverse_proxy app:8501
# }
